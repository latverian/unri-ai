# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.

# Cek kesiapan kapan saja dengan: python -m app.check

# --- LLM ---
LLM_PROVIDER=gemini              # gemini (free tier, paling ringan) | ollama (lokal, offline)
LLM_FALLBACK=ollama              # cadangan jika provider utama gagal; kosongkan jika tidak punya Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=                  # dari https://aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash

# --- Embedding ---
EMBED_PROVIDER=gemini            # gemini (ringan) | local (offline, perlu requirements-local-embed.txt)
EMBED_MODEL=intfloat/multilingual-e5-small
GEMINI_EMBED_MODEL=gemini-embedding-001
# Catatan: ganti EMBED_PROVIDER/EMBED_MODEL = hapus folder data/chroma lalu proses ulang semua dokumen.

# --- RAG ---
TOP_K=4
MIN_SCORE=0.6                    # titik awal untuk embedding gemini; untuk local (e5) mulai dari 0.75.
                                 # Terlalu sering "tidak ditemukan"? turunkan. Sering melenceng? naikkan.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Server ---
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MIN=20
LOG_RETENTION_DAYS=90

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=             # buat dengan: python -m app.core.security hash "passwordmu"
JWT_SECRET=                      # string acak panjang, mis.: python -c "import secrets;print(secrets.token_urlsafe(48))"

# --- Akun pengguna ---
ALLOW_REGISTRATION=true          # false = hanya bisa bertanya sebagai tamu
USER_JWT_DAYS=30                 # lama sesi login mahasiswa
APP_URL=http://localhost:5173    # alamat frontend, untuk tautan reset kata sandi
# Email reset kata sandi (opsional). Tanpa SMTP, admin membuat tautan reset di halaman Pengguna.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Fitur chat ---
ALLOW_GENERAL_MODE=true          # mode "Umum": menjawab pertanyaan umum bila tidak ada di dokumen
MAX_ATTACHMENT_MB=10             # batas ukuran lampiran chat
# Model yang bisa dipilih pengguna (format provider:model=Label, pisahkan koma). Kosong = LLM_PROVIDER saja.
# Contoh: LLM_MODELS=gemini:gemini-2.5-flash=Gemini Flash (cepat),gemini:gemini-2.5-pro=Gemini Pro (teliti),ollama:qwen2.5:3b=Qwen 3B (lokal)
LLM_MODELS=
