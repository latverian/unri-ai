# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.

# --- LLM ---
LLM_PROVIDER=ollama              # ollama (lokal, gratis) | gemini (free tier)
LLM_FALLBACK=                    # opsional, mis. gemini; dipakai kalau provider utama gagal
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=                  # dari https://aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash

# --- Embedding ---
EMBED_PROVIDER=local             # local (perlu requirements-local-embed.txt) | gemini
EMBED_MODEL=intfloat/multilingual-e5-small
GEMINI_EMBED_MODEL=gemini-embedding-001
# Catatan: ganti EMBED_PROVIDER/EMBED_MODEL = hapus folder data/chroma lalu proses ulang semua dokumen.

# --- RAG ---
TOP_K=4
MIN_SCORE=0.75                   # turunkan (0.7) jika terlalu sering "tidak ditemukan"; untuk gemini coba 0.6
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Server ---
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MIN=20
LOG_RETENTION_DAYS=90

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=             # buat dengan: python -m app.core.security hash "passwordmu"
JWT_SECRET=                      # string acak panjang, mis.: python -c "import secrets;print(secrets.token_urlsafe(48))"
